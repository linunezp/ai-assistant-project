# =============================================================================
# CONFIGURACIÓN DEL ASISTENTE DE IA LOCAL
# =============================================================================

# Puerto del servidor
PORT=3000

# Configuración de CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# =============================================================================
# REPOSITORY PLATFORMS CONFIGURATION
# =============================================================================

# Plataforma de repositorio por defecto (gitlab, github)
REPOSITORY_PLATFORM=gitlab

# =============================================================================
# GITLAB CONFIGURATION
# =============================================================================

# URL de la API de GitLab (para tu instancia de GitLab)
GITLAB_API_URL=https://gvs.coordinador.cl/api/v4

# Token privado de GitLab (Necesario: crear en GitLab > Settings > Access Tokens)
# Permisos requeridos: read_api, read_repository
# No incluyas tokens reales en este archivo. Usa `.env` para tus credenciales locales.
GITLAB_PRIVATE_TOKEN=your_gitlab_private_token_here

# ID del proyecto de GitLab (puedes encontrarlo en la página principal del proyecto)
# Para el proyecto: 00-arquitectura/poc-ia/ai-assistant-project
GITLAB_PROJECT_ID=your_project_id_here

# ID del grupo de GitLab (opcional) - si configuras esto, el script de ingest
# iterará por todos los proyectos del grupo y los indexará.
# GITLAB_GROUP_ID=your_group_id_here

# =============================================================================
# GITHUB CONFIGURATION
# =============================================================================

# URL de la API de GitHub (normalmente https://api.github.com)
GITHUB_API_URL=https://api.github.com

# Token de acceso personal de GitHub (Necesario: crear en GitHub > Settings > Developer settings > Personal access tokens)
# Permisos requeridos: repo (para repositorios privados), public_repo (para repositorios públicos)
GITHUB_ACCESS_TOKEN=your_github_access_token_here

# Nombre de usuario de GitHub (opcional)
GITHUB_USERNAME=your_github_username_here

# Organización de GitHub (opcional) - si configuras esto, el script de ingest
# iterará por todos los repositorios de la organización y los indexará.
GITHUB_ORGANIZATION=your_github_organization_here

# Configuración adicional de GitHub
GITHUB_RETRY_COUNT=3
GITHUB_RETRY_DELAY_MS=2000

# =============================================================================
# AI PROVIDERS CONFIGURATION
# =============================================================================

# Proveedor de IA por defecto (gemini, claude, openai)
AI_PROVIDER=gemini

# =============================================================================
# GOOGLE GEMINI CONFIGURATION
# =============================================================================

# Clave de API de Google Gemini (Obtener en: https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Modelo de Gemini a utilizar (opciones: gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# =============================================================================
# ANTHROPIC CLAUDE CONFIGURATION
# =============================================================================

# Clave de API de Anthropic Claude (Obtener en: https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Modelo de Claude a utilizar (claude-3-haiku-20240307, claude-3-5-sonnet-latest disponibles)
ANTHROPIC_MODEL=claude-3-haiku-20240307

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================

# Clave de API de OpenAI (Obtener en: https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Modelo de OpenAI a utilizar (gpt-4o-mini, gpt-4o, gpt-3.5-turbo disponibles)
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL con pgvector)
# =============================================================================

# Host de la base de datos
DB_HOST=localhost

# Puerto de la base de datos
DB_PORT=5432

# Nombre de la base de datos
DB_NAME=ai_assistant

# Usuario de la base de datos
DB_USER=postgres

# Contraseña de la base de datos
DB_PASSWORD=your_database_password_here

# =============================================================================
# CONFIGURACIÓN AVANZADA (Opcional)
# =============================================================================

# Nivel de logging (error, warn, info, debug)
LOG_LEVEL=info

# Número máximo de resultados de búsqueda
DEFAULT_SEARCH_LIMIT=5

# Umbral mínimo de relevancia para búsquedas
DEFAULT_SEARCH_THRESHOLD=0.3

# Tamaño máximo de chunk para dividir documentos (en caracteres)
MAX_CHUNK_SIZE=1000

# Superposición entre chunks (en caracteres)
CHUNK_OVERLAP=200

# Timeout para peticiones a APIs externas (en ms)
API_TIMEOUT=30000

# =============================================================================
# CONFIGURACIÓN DE DESARROLLO
# =============================================================================

# Entorno de ejecución (development, production)
NODE_ENV=development

# Habilitar validación de preguntas (true/false)
ENABLE_QUESTION_VALIDATION=true

# Habilitar mejora automática de consultas (true/false)
ENABLE_QUERY_ENHANCEMENT=true