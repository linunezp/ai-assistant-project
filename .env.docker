# Variables para docker-compose (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_assistant
DB_USER=postgres
DB_PASSWORD=postgres
# Opcional: tamaño del vector (ajustar según modelo de embeddings)
EMBEDDING_DIM=1536

# Variables requeridas por la imagen oficial postgres
POSTGRES_USER=${DB_USER}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_DB=${DB_NAME}
